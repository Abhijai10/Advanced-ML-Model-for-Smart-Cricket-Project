# =========================
# 📊 ML Data (IMPORTANT)
# =========================

# Raw videos (large files)
ml/data/raw_videos/

# Ignore ALL processed data by default
ml/data/processed/*

# Keep finalized ML dataset artifacts
!ml/data/final/
!ml/data/final/**

# Keep ONLY final dataset
!ml/data/processed/pose_sequences/
!ml/data/processed/pose_sequences/**

# Sample/debug feature testing
ml/data/samples/

# =========================
# 🤖 ML Models
# =========================
ml/models/
*.pt
!ml/artifacts/phase8/best_model/checkpoint.pt
*.pth
*.onnx
*.tflite
*.task

# Ignore generic model/checkpoint pickle files
*.pkl

# Keep finalized dataset label encoder
!ml/data/final/label_encoder.pkl

# Keep temporal dataset label encoder
!ml/data/final_temporal/temporal_label_encoder.pkl

# =========================
# 📝 Logs
# =========================
*.log
logs/

# =========================
# 📄 Documents
# =========================
*.pdf

# Ignore all Smart Cricket docs by default
Smart Cricket DOCS/*

# Keep core architecture docs
!Smart Cricket DOCS/00_CORE DOCS/
!Smart Cricket DOCS/00_CORE DOCS/**

# Ignore Obsidian metadata
Smart Cricket DOCS/.obsidian/

.continue/
CLAUDE.md

# =========================
# 🎥 Media Files
# =========================
*.mp4
*.mov
*.avi
*.mkv
ml/artifacts/phase14/audio_output/*.wav
!ml/artifacts/phase14/audio_output/sample_spoken_feedback.wav

# =========================
