# Environment
SMART_CRICKET_ENV=development
SMART_CRICKET_DEPLOYMENT_BASE_URL=http://127.0.0.1:8000

# API
SMART_CRICKET_ENABLE_DEV_DATASET_ENDPOINTS=false
SMART_CRICKET_MAX_UPLOAD_BYTES=262144000
SMART_CRICKET_MAX_VIDEO_DURATION_SECONDS=20
SMART_CRICKET_MAX_VIDEO_PIXELS=2073600
SMART_CRICKET_UNCERTAINTY_CONFIDENCE_PERCENT=55
SMART_CRICKET_MIN_CLEAN_POSE_FRAMES=20

# Auth
SMART_CRICKET_REQUIRE_AUTH=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SMART_CRICKET_JWKS_TIMEOUT_SECONDS=5
SMART_CRICKET_JWKS_CACHE_TTL_SECONDS=600

# Persistence
SUPABASE_SERVICE_ROLE_KEY=
SMART_CRICKET_REQUIRE_FEEDBACK_PERSISTENCE=true
SMART_CRICKET_PERSISTENCE_TIMEOUT_SECONDS=8

# Evidence
SMART_CRICKET_ALLOW_MODEL_IMPROVEMENT_PARTICIPATION=false
SMART_CRICKET_MODEL_IMPROVEMENT_CONSENT_VERSION=2026-08-04-v1
SMART_CRICKET_EVIDENCE_RETENTION_DAYS=30
SMART_CRICKET_EVIDENCE_STORAGE_BACKEND=none
SMART_CRICKET_EVIDENCE_LOCAL_STORAGE_DIR=/tmp/smart-cricket-evidence
SMART_CRICKET_EVIDENCE_SUPABASE_BUCKET=

# Rate limiting
SMART_CRICKET_RATE_LIMIT_PER_MINUTE=20
SMART_CRICKET_FEEDBACK_RATE_LIMIT_PER_MINUTE=30
SMART_CRICKET_RATE_LIMIT_BACKEND=memory
SMART_CRICKET_REDIS_URL=
SMART_CRICKET_TRUSTED_PROXY_HOPS=0

# Inference
SMART_CRICKET_MAX_CONCURRENT_ANALYSES=1
SMART_CRICKET_ANALYSIS_QUEUE_TIMEOUT_SECONDS=3
SMART_CRICKET_ANALYSIS_EXECUTION_TIMEOUT_SECONDS=45

# Audio/TTS
SMART_CRICKET_AUDIO_OUTPUT_DIR=/tmp/smart-cricket-audio
SMART_CRICKET_AUDIO_SIGNING_SECRET=
SMART_CRICKET_AUDIO_URL_TTL_SECONDS=900
SMART_CRICKET_AUDIO_MAX_URL_TTL_SECONDS=3600
SMART_CRICKET_AUDIO_RETENTION_SECONDS=3600

# CORS
SMART_CRICKET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Monitoring
SMART_CRICKET_SENTRY_DSN=

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
