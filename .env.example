# Smart Cricket API
SMART_CRICKET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SMART_CRICKET_ENABLE_DEV_DATASET_ENDPOINTS=false
SMART_CRICKET_REQUIRE_AUTH=false
SUPABASE_JWT_SECRET=
SMART_CRICKET_RATE_LIMIT_PER_MINUTE=20
SMART_CRICKET_MAX_UPLOAD_BYTES=262144000
SMART_CRICKET_MAX_VIDEO_DURATION_SECONDS=20
SMART_CRICKET_MAX_VIDEO_PIXELS=2073600
SMART_CRICKET_AUDIO_OUTPUT_DIR=/tmp/smart-cricket-audio

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
